# Don't let the user's environment (PATH etc.) leak into actions.
common --incompatible_strict_action_env

# Opt out of Aspect ruleset usage telemetry (and its startup notice).
common --repo_env=DO_NOT_TRACK=1

# Step 5b: uncomment once aspect_rules_ts is enabled in MODULE.bazel.
# tsc also transpiles, until SWC takes over in step 6.
common --@aspect_rules_ts//ts:default_to_tsc_transpiler
common --@aspect_rules_ts//ts:skipLibCheck=always

# Local overrides that shouldn't be checked in.
try-import %workspace%/.bazelrc.user
