load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm//:defs.bzl", "npm_link_all_packages")

# Gazelle directives live in BUILD files as "load-bearing comments".
# They are inherited by every package below this one.

# Each pnpm workspace package gets an npm_package target that other packages
# link as node_modules/@demo/<name>. Call it "pkg", the name rules_js links.
# gazelle:js_npm_package_target_name pkg

# The JS Gazelle language only globs TypeScript by default. Our sources start
# out as .js and become .ts in step 5, so include both.
# gazelle:js_files **/*.{js,ts}
# gazelle:js_test_files **/*.test.{js,ts}

# The jest.axl Starlark plugin (tools/gazelle/jest.axl) generates a jest_test
# in every package with test files.
# gazelle:jest enabled

# Generate our ts_project macro (SWC transpiler) instead of rules_ts's.
# gazelle:map_kind ts_project ts_project //tools/ts:defs.bzl

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
)
