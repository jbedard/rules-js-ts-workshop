"BazelCon 2026 workshop: rules_{js|ts}: JavaScript & TypeScript with Bazel"

module(name = "rules_js_ts_workshop")

# Node.js: Bazel downloads the version named in .nvmrc, the same file nvm and
# other non-Bazel tooling read, so step 1 and the Bazel steps agree.
bazel_dep(name = "rules_nodejs", version = "6.7.4")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version_from_nvmrc = "//:.nvmrc")

# JavaScript: npm packages from pnpm-lock.yaml, js_library, js_binary, ...
bazel_dep(name = "aspect_rules_js", version = "3.5.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

