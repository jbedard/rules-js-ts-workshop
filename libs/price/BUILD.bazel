load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "price",
    srcs = [
        "index.ts",
        "price.ts",
    ],
    declaration = True,
    tsconfig = "//:tsconfig",
)

ts_project(
    name = "price_tests",
    testonly = True,
    srcs = ["price.test.ts"],
    declaration = True,
    tsconfig = "//:tsconfig",
    deps = [
        ":node_modules/@jest/globals",
        ":price",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":price",
    ],
    visibility = ["//:__pkg__"],
)
