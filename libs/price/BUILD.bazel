load("@aspect_rules_jest//jest:defs.bzl", "jest_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/ts:defs.bzl", "ts_project")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "price",
    srcs = [
        "index.ts",
        "price.ts",
    ],
    declaration = True,
    isolated_typecheck = True,
    tsconfig = "//:tsconfig",
)

ts_project(
    name = "price_tests",
    testonly = True,
    srcs = ["price.test.ts"],
    declaration = True,
    isolated_typecheck = True,
    tsconfig = "//:tsconfig",
    deps = [
        ":node_modules/@jest/globals",
        ":price",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":price",
    ],
    visibility = ["//:__pkg__"],
)

jest_test(
    name = "test",
    data = [
        "package.json",
        ":price_tests",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)
