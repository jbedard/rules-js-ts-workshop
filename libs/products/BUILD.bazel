load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "products",
    srcs = [
        "filter.ts",
        "index.ts",
        "products.ts",
    ],
    declaration = True,
    tsconfig = "//:tsconfig",
)

ts_project(
    name = "products_tests",
    testonly = True,
    srcs = ["filter.test.ts"],
    declaration = True,
    tsconfig = "//:tsconfig",
    deps = [
        ":node_modules/@jest/globals",
        ":products",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":products",
    ],
    visibility = ["//:__pkg__"],
)
