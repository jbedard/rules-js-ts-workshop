load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "ui",
    srcs = [
        "ProductCategoryRow.ts",
        "ProductRow.ts",
        "ProductTable.ts",
        "SearchBar.ts",
        "index.ts",
    ],
    declaration = True,
    tsconfig = "//:tsconfig",
    deps = [
        ":node_modules/@demo/products",
        ":node_modules/@types/react",
        ":node_modules/react",
    ],
)

ts_project(
    name = "ui_tests",
    testonly = True,
    srcs = ["ProductRow.test.ts"],
    declaration = True,
    tsconfig = "//:tsconfig",
    deps = [
        ":node_modules/@demo/products",
        ":node_modules/@jest/globals",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":ui",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":ui",
    ],
    visibility = ["//:__pkg__"],
)
